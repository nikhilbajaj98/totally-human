{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Scrape Requests / sec (by Strategy)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(totallyhuman_scrape_requests_total[1m])",
          "legendFormat": "{{strategy}} / {{status}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Free vs Premium (Total)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "right" } },
      "targets": [
        {
          "expr": "sum by (strategy) (totallyhuman_scrape_requests_total{status=\"done\"})",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Cost Saved (Free Successes)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "totallyhuman_cost_saved_total",
          "legendFormat": "Paid calls saved",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Fallbacks / sec (by Reason)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(totallyhuman_fallbacks_total[1m])",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Scrape Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, strategy) (rate(totallyhuman_scrape_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{strategy}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(totallyhuman_scrape_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{strategy}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, strategy) (rate(totallyhuman_scrape_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{strategy}}",
          "refId": "C"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Premium Budget Used",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 900 }
            ]
          },
          "max": 1000,
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "totallyhuman_premium_budget_used{job=\"worker\"}",
          "legendFormat": "Usage",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Sidekiq Jobs Processed / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(sidekiq_jobs_executed_total[1m])",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Sidekiq Failed Jobs / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(sidekiq_jobs_failed_total[1m])",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Scrape requests (dashboard time range)",
      "description": "Increase in totallyhuman_scrape_requests_total over the selected range (worker counters).",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "sum(increase(totallyhuman_scrape_requests_total[$__range]))",
          "legendFormat": "scrapes",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Fallbacks (dashboard time range)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "yellow", "value": null }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "sum(increase(totallyhuman_fallbacks_total[$__range]))",
          "legendFormat": "fallbacks",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Cost saved (current counter)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "totallyhuman_cost_saved_total",
          "legendFormat": "saved",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Premium usage (gauge value)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "totallyhuman_premium_budget_used{job=\"worker\"}",
          "legendFormat": "premium calls",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Total scrape throughput (all strategies)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(totallyhuman_scrape_requests_total[1m]))",
          "legendFormat": "total req/s",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "By strategy × status (instant)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "expr": "sum by (strategy, status) (totallyhuman_scrape_requests_total)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ],
  "schemaVersion": 39,
  "tags": ["totallyhuman", "scraping"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "TotallyHuman - Scraping Dashboard",
  "uid": "totallyhuman-main",
  "version": 1
}
